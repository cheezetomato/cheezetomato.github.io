rules_version = '2';

// cheezetomato.github.io Firestore 보안 규칙
// - 여기 적지 않은 컬렉션은 전부 막힘 (기본 거부)
// - 적용: Firebase 콘솔 > Firestore Database > 규칙 탭에 붙여넣고 게시
// - 코드에서 컬렉션이나 저장하는 칸을 바꾸면 이 파일도 같이 고칠 것

service cloud.firestore {
  match /databases/{database}/documents {

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // 🍎 사과 게임 기록: 누구나 보기(read) + 새 기록 등록(create)만 가능.
    // 기존 기록 수정/삭제는 불가. 점수는 0~180점(10x18 그리드 최대치)만 허용.
    // 저장하는 칸은 name, score, date, timestamp, clearTime(다 땄을 때만)뿐.
    match /appleRecords/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'date', 'timestamp', 'clearTime'])
                    && request.resource.data.keys().hasAll(['name', 'score', 'date', 'timestamp'])
                    && shortText(request.resource.data.name, 20)
                    && request.resource.data.name.size() > 0
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 180
                    && shortText(request.resource.data.date, 20)
                    && request.resource.data.timestamp is int
                    && (!('clearTime' in request.resource.data)
                        || (request.resource.data.clearTime is number
                            && request.resource.data.clearTime > 0
                            && request.resource.data.clearTime <= 120
                            && request.resource.data.score == 180));
      allow update, delete: if false;
    }

    // 🎬 영화 갤러리: 누구나 구경(read) 가능, 추가/수정/삭제(write)는 오직 '창조자'만!
    // (request.auth != null 만으로는 부족: 공개 apiKey로 누구나 계정을 만들 수 있음)
    match /myMoviesGallery/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'LjObLa6943Q1xyyVthX2aFA1zRQ2';
    }

    // 💣 지뢰찾기 기록: 누구나 보기 가능. 문서는 네 난이도뿐, 칸은 noguess 하나.
    // 첫 기록 생성은 자유, 갱신은 "기존 기록보다 빠를 때만" 허용. 삭제는 불가.
    match /minesweeper_records/{difficulty} {
      allow read: if true;
      allow create: if difficulty in ['초급', '중급', '고급', '최상급']
                    && request.resource.data.keys().hasOnly(['noguess'])
                    && request.resource.data.noguess is number
                    && request.resource.data.noguess > 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noguess'])
                    && request.resource.data.noguess is number
                    && request.resource.data.noguess > 0
                    && (!('noguess' in resource.data)
                        || request.resource.data.noguess < resource.data.noguess);
      allow delete: if false;
    }

    // 🎮 온라인 대전 공개 방 목록 (대칭 퍼즐·벽바둑·십이장기)
    // 방장이 열고, 15초마다 갱신하고, 나갈 때 지움. 로그인 없는 게임이라 형식만 검사.
    match /gameRooms/{roomId} {
      allow read: if true;
      allow create, update: if roomId.size() <= 64
                    && request.resource.data.keys().hasOnly(['game', 'name', 'host', 'count', 'max', 'playing', 'note', 'ts'])
                    && request.resource.data.game in ['wallgo', 'symmetry', 'janggi']
                    && shortText(request.resource.data.name, 40)
                    && shortText(request.resource.data.host, 15)
                    && request.resource.data.count is int
                    && request.resource.data.count >= 0
                    && request.resource.data.count <= 4
                    && request.resource.data.max is int
                    && request.resource.data.max >= 2
                    && request.resource.data.max <= 4
                    && request.resource.data.playing is bool
                    && shortText(request.resource.data.note, 120)
                    && request.resource.data.ts is int;
      allow delete: if true;
    }

  }
}
